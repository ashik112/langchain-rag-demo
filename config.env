# LangChain RAG Demo Configuration
# Copy this file to .env and customize your settings

# Required: Google Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here

# Environment: development, production, micro, docker
ENV=development

# Port to run the application on
PORT=5000

# Resource limits (for Docker deployment)
CPU_LIMIT=1.0
MEMORY_LIMIT=1G
CPU_RESERVATION=0.25
MEMORY_RESERVATION=256M

# For small servers (like GCE e2-micro), uncomment these:
# ENV=micro
# CPU_LIMIT=0.8
# MEMORY_LIMIT=800M
# CPU_RESERVATION=0.2
# MEMORY_RESERVATION=200M

# Flask settings
FLASK_ENV=production
PYTHONUNBUFFERED=1 